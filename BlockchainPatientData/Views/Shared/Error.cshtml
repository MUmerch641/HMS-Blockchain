@{
    ViewData["Title"] = "Error";
}

<div style="max-width: 900px; margin: 80px auto; padding: 0 20px;">
    <div style="background: white; border-radius: 15px; box-shadow: 0 15px 50px rgba(0,0,0,0.2); overflow: hidden; border: 3px solid #dc3545;">
        <div style="background: linear-gradient(135deg, #dc3545 0%, #bb2d3b 100%); color: white; padding: 40px; text-align: center;">
            <h1 style="font-size: 4rem; margin: 0; font-weight: 700;">❌ Error</h1>
        </div>
        <div style="padding: 40px;">
            <h2 style="color: #dc3545; text-align: center; margin-bottom: 30px; font-size: 1.8rem;">
                An error occurred while processing your request.
            </h2>
            
            @if (ViewBag.Error != null)
            {
                <div style="background-color: #f8d7da; color: #721c24; border: 2px solid #dc3545; border-radius: 10px; padding: 20px; margin-bottom: 30px; border-left: 6px solid #dc3545;">
                    <h5 style="margin: 0 0 10px 0; font-weight: 600;">Error Details:</h5>
                    <p style="margin: 0; font-size: 1.05rem;">@ViewBag.Error</p>
                </div>
            }
            
            <div style="background: linear-gradient(145deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 10px; padding: 25px; margin-bottom: 30px;">
                <h4 style="margin: 0 0 15px 0; color: #2d3748;">What you can do:</h4>
                <ul style="margin: 0; padding-left: 25px; color: #6c757d; line-height: 1.8;">
                    <li>Go back to the <a href="/" style="color: #0d6efd; text-decoration: underline; font-weight: 600;">homepage</a></li>
                    <li>Try the <a href="/Hospital/Dashboard" style="color: #0d6efd; text-decoration: underline; font-weight: 600;">Hospital Dashboard</a></li>
                    <li>Contact support if the problem persists</li>
                </ul>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <a href="/" 
                   style="padding: 14px; background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%); color: white; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.3s ease;"
                   onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(13, 110, 253, 0.4)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                    🏠 Go to Homepage
                </a>
                <a href="javascript:history.back()" 
                   style="padding: 14px; background-color: #6c757d; color: white; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 600; transition: all 0.3s ease;"
                   onmouseover="this.style.backgroundColor='#5a6268';"
                   onmouseout="this.style.backgroundColor='#6c757d';">
                    ← Go Back
                </a>
            </div>
        </div>
        <div style="background-color: #f8f9fa; border-top: 1px solid #dee2e6; padding: 15px 40px; text-align: center;">
            <small style="color: #6c757d;">Request ID: @ViewContext.HttpContext.TraceIdentifier</small>
        </div>
    </div>
</div>

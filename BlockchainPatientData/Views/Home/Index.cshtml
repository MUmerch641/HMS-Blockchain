@{
    ViewData["Title"] = "Blockchain Patient Data Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
</head>
<body>

<!-- HERO SECTION -->
<div style="background:#f5f6fa;color:#2c3e50;padding:60px 20px;text-align:center;">
    <div style="max-width:1200px;margin:auto;">
        <h1 style="font-size:clamp(2rem,5vw,3.5rem);font-weight:700;margin:0 0 20px;color:#2c3e50;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
            Blockchain-Based Patient Data Management
        </h1>
        <p style="font-size:clamp(1rem,2vw,1.2rem);max-width:700px;margin:auto auto 40px;color:#555;line-height:1.6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
            Secure, Transparent, and Tamper-Proof Healthcare Records using Blockchain Technology
        </p>

        <!-- FEATURE CARDS -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-bottom:50px;">
            <div style="background:#fff;padding:30px 25px;border-radius:8px;box-shadow:0 2px 8px rgba(44,62,80,.1);transition:all .3s ease;">
                <div style="font-size:2.5rem;margin-bottom:15px;">Link</div>
                <h4 style="margin:0 0 10px;font-weight:600;color:#2c3e50;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Blockchain Security</h4>
                <p style="color:#666;margin:0;font-size:.95rem;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">SHA256 hashing ensures data immutability and tamper-proof records</p>
            </div>
            <div style="background:#fff;padding:30px 25px;border-radius:8px;box-shadow:0 2px 8px rgba(44,62,80,.1);transition:all .3s ease;">
                <div style="font-size:2.5rem;margin-bottom:15px;">Document</div>
                <h4 style="margin:0 0 10px;font-weight:600;color:#2c3e50;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Smart Contracts</h4>
                <p style="color:#666;margin:0;font-size:.95rem;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Automated insurance claim triggers based on predefined rules</p>
            </div>
            <div style="background:#fff;padding:30px 25px;border-radius:8px;box-shadow:0 2px 8px rgba(44,62,80,.1);transition:all .3s ease;">
                <div style="font-size:2.5rem;margin-bottom:15px;">Robot</div>
                <h4 style="margin:0 0 10px;font-weight:600;color:#2c3e50;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">AI Fraud Detection</h4>
                <p style="color:#666;margin:0;font-size:.95rem;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Intelligent system to detect suspicious transactions automatically</p>
            </div>
        </div>

        <!-- PORTAL SELECTION -->
        <h2 style="margin:0 0 30px;font-size:clamp(1.5rem,4vw,2rem);font-weight:600;color:#2c3e50;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
            Select Your Portal
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;">
            <a href="/Hospital/Dashboard" style="text-decoration:none;">
                <div style="background:#0078d7;color:#fff;padding:50px 30px;border-radius:8px;box-shadow:0 4px 12px rgba(0,120,215,.2);transition:all .3s ease;min-height:160px;display:flex;flex-direction:column;justify-content:center;cursor:pointer;"
                     onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 8px 20px rgba(0,120,215,.3)'"
                     onmouseout="this.style.transform='';this.style.boxShadow='0 4px 12px rgba(0,120,215,.2)'">
                    <h3 style="font-size:clamp(1.3rem,3vw,1.6rem);margin:0 0 10px;font-weight:600;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Hospital Portal</h3>
                    <p style="margin:0;font-size:1rem;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Register patients &amp; create bills</p>
                </div>
            </a>
            <a href="/Insurance/Dashboard" style="text-decoration:none;">
                <div style="background:#16a085;color:#fff;padding:50px 30px;border-radius:8px;box-shadow:0 4px 12px rgba(22,160,133,.2);transition:all .3s ease;min-height:160px;display:flex;flex-direction:column;justify-content:center;cursor:pointer;"
                     onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 8px 20px rgba(22,160,133,.3)'"
                     onmouseout="this.style.transform='';this.style.boxShadow='0 4px 12px rgba(22,160,133,.2)'">
                    <h3 style="font-size:clamp(1.3rem,3vw,1.6rem);margin:0 0 10px;font-weight:600;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Insurance Portal</h3>
                    <p style="margin:0;font-size:1rem;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Verify claims &amp; detect fraud</p>
                </div>
            </a>
            <a href="/Patient/Login" style="text-decoration:none;">
                <div style="background:#0078d7;color:#fff;padding:50px 30px;border-radius:8px;box-shadow:0 4px 12px rgba(0,120,215,.2);transition:all .3s ease;min-height:160px;display:flex;flex-direction:column;justify-content:center;cursor:pointer;"
                     onmouseover="this.style.transform='translateY(-6px)';this.style.boxShadow='0 8px 20px rgba(0,120,215,.3)'"
                     onmouseout="this.style.transform='';this.style.boxShadow='0 4px 12px rgba(0,120,215,.2)'">
                    <h3 style="font-size:clamp(1.3rem,3vw,1.6rem);margin:0 0 10px;font-weight:600;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Patient Portal</h3>
                    <p style="margin:0;font-size:1rem;line-height:1.5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">View your medical records</p>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- FEATURES & ARCHITECTURE -->
<div style="max-width:1200px;margin:60px auto;padding:0 20px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:40px;">
        <!-- KEY FEATURES -->
        <div>
            <h3 style="color:#2c3e50;font-size:clamp(1.3rem,3vw,1.6rem);font-weight:600;margin:0 0 25px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">Key Features</h3>
            <ul style="list-style:none;padding:0;margin:0;">
                <li style="padding:12px 0;border-bottom:1px solid #e8e8e8;font-size:.95rem;color:#333;line-height:1.6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
                    Success <strong>NFT Health IDs</strong> - Unique blockchain identity for each patient
                </li>
                <li style="padding:12px 0;border-bottom:1px solid #e8e8e8;font-size:.95rem;color:#333;line-height:1.6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
                    Success <strong>Immutable Records</strong> - Data cannot be altered or deleted
                </li>
                <li style="padding:12px 0;border-bottom:1px solid #e8e8e8;font-size:.95rem;color:#333;line-height:1.6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
                    Success <strong>Transparent Ledger</strong> - Complete audit trail of all transactions
                </li>
                <li style="padding:12px 0;border-bottom:1px solid #e8e8e8;font-size:.95rem;color:#333;line-height:1.6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
                    Success <strong>Auto Insurance</strong> - Smart contracts trigger micro-insurance automatically
                </li>
                <li style="padding:12px 0;font-size:.95rem;color:#333;line-height:1.6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
                    Success <strong>Fraud Prevention</strong> - AI-powered suspicious activity detection
                </li>
            </ul>
        </div>

        <!-- SYSTEM ARCHITECTURE -->
        <div>
            <h3 style="color:#2c3e50;font-size:clamp(1.3rem,3vw,1.6rem);font-weight:600;margin:0 0 25px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">System Architecture</h3>
            <div style="background:#fff;padding:30px;border-radius:8px;border:1px solid #e0e0e0;box-shadow:0 2px 8px rgba(44,62,80,.08);">
                <pre style="font-family:'Courier New',monospace;color:#2c3e50;line-height:1.8;margin:0;font-size:clamp(.75rem,1.5vw,.9rem);white-space:pre-wrap;word-wrap:break-word;">
[Hospital] to [Bill Creation] to [SHA256 Hash]
    down
 [Blockchain Ledger]
    down
[Smart Contract Evaluation]
    down
[Insurance Claim Trigger]
    down
  [Fraud Detection AI]</pre>
            </div>
        </div>
    </div>
</div>

</body>
</html>
@{
    ViewData["Title"] = "Hospital Dashboard";
}

<div style="background: #F5F6FA; min-height: 100vh; padding: 30px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
    <div style="max-width: 1400px; margin: 0 auto;">
        <!-- Header with Logout -->
        <div style="margin-bottom: 35px; display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 20px;">
            <div>
                <h1 style="font-size: clamp(1.75rem, 4vw, 2.25rem); color: #2C3E50; font-weight: 600; margin-bottom: 8px;">
                    🏥 Hospital Dashboard
                </h1>
                <p style="font-size: clamp(0.95rem, 2vw, 1.05rem); color: #7F8C8D; margin: 0;">
                    Manage patients and create blockchain-secured medical records
                </p>
            </div>
            <div style="display: flex; gap: 12px;">
                <a href="/Hospital/Login" 
                   style="background: #E74C3C; color: white; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 500; transition: all 0.3s; display: inline-flex; align-items: center; gap: 8px; font-size: 0.95rem;"
                   onmouseover="this.style.backgroundColor='#C0392B'; this.style.transform='translateY(-2px)'"
                   onmouseout="this.style.backgroundColor='#E74C3C'; this.style.transform='translateY(0)'">
                    🚪 Logout
                </a>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div style="background: #FEF2F2; color: #E74C3C; padding: 16px 20px; border-radius: 8px; border-left: 4px solid #E74C3C; margin-bottom: 25px; font-size: 0.95rem;">
                <strong>Error:</strong> @ViewBag.Error
            </div>
        }

        <!-- Stats Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 35px;">
            <!-- Total Patients -->
            <div style="background: #FFFFFF; padding: 28px; border-radius: 10px; box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08); border-left: 4px solid #0078D7; transition: all 0.3s ease;" 
                 onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 4px 16px rgba(0, 120, 215, 0.15)';"
                 onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(44, 62, 80, 0.08)';">
                <div style="color: #7F8C8D; font-size: 0.85rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">Total Patients</div>
                <div style="color: #2C3E50; font-size: clamp(2rem, 5vw, 2.5rem); font-weight: 700; margin-bottom: 8px;">@ViewBag.TotalPatients</div>
                <div style="color: #16A085; font-size: 0.9rem; font-weight: 500;">✓ Registered</div>
            </div>

            <!-- Blockchain Status -->
            <div style="background: #FFFFFF; padding: 28px; border-radius: 10px; box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08); border-left: 4px solid #16A085; transition: all 0.3s ease;"
                 onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 4px 16px rgba(22, 160, 133, 0.15)';"
                 onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(44, 62, 80, 0.08)';">
                <div style="color: #7F8C8D; font-size: 0.85rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">Blockchain</div>
                <div style="color: #2C3E50; font-size: clamp(1.25rem, 3vw, 1.5rem); font-weight: 600; margin-bottom: 8px;">🔗 Active</div>
                <div style="color: #16A085; font-size: 0.9rem; font-weight: 500;">Ledger Secured</div>
            </div>

            <!-- Smart Contracts -->
            <div style="background: #FFFFFF; padding: 28px; border-radius: 10px; box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08); border-left: 4px solid #0078D7; transition: all 0.3s ease;"
                 onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 4px 16px rgba(0, 120, 215, 0.15)';"
                 onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(44, 62, 80, 0.08)';">
                <div style="color: #7F8C8D; font-size: 0.85rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">Smart Contracts</div>
                <div style="color: #2C3E50; font-size: clamp(1.25rem, 3vw, 1.5rem); font-weight: 600; margin-bottom: 8px;">⚡ Running</div>
                <div style="color: #0078D7; font-size: 0.9rem; font-weight: 500;">Auto Insurance</div>
            </div>

            <!-- AI Fraud Detection -->
            <div style="background: #FFFFFF; padding: 28px; border-radius: 10px; box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08); border-left: 4px solid #F1C40F; transition: all 0.3s ease;"
                 onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 4px 16px rgba(241, 196, 15, 0.15)';"
                 onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(44, 62, 80, 0.08)';">
                <div style="color: #7F8C8D; font-size: 0.85rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px;">AI Detection</div>
                <div style="color: #2C3E50; font-size: clamp(1.25rem, 3vw, 1.5rem); font-weight: 600; margin-bottom: 8px;">🤖 Enabled</div>
                <div style="color: #F1C40F; font-size: 0.9rem; font-weight: 500;">Monitoring</div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 35px;">
            <!-- Register Patient -->
            <a href="/Hospital/AddPatient" style="text-decoration: none;">
                <div style="background: #FFFFFF; padding: 40px 30px; border-radius: 10px; box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08); text-align: center; transition: all 0.3s ease; border: 2px solid transparent; min-height: 220px; display: flex; flex-direction: column; justify-content: center;"
                     onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 8px 20px rgba(0, 120, 215, 0.15)'; this.style.borderColor='#0078D7';"
                     onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(44, 62, 80, 0.08)'; this.style.borderColor='transparent';">
                    <div style="font-size: clamp(3rem, 8vw, 4rem); margin-bottom: 18px;">👤</div>
                    <h3 style="color: #2C3E50; margin: 0 0 10px; font-size: clamp(1.15rem, 2.5vw, 1.35rem); font-weight: 600;">Register New Patient</h3>
                    <p style="color: #7F8C8D; margin: 0; font-size: 0.95rem; line-height: 1.5;">Create patient record with NFT Health ID</p>
                </div>
            </a>

            <!-- Create Bill -->
            <a href="/Hospital/AddBill" style="text-decoration: none;">
                <div style="background: #FFFFFF; padding: 40px 30px; border-radius: 10px; box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08); text-align: center; transition: all 0.3s ease; border: 2px solid transparent; min-height: 220px; display: flex; flex-direction: column; justify-content: center;"
                     onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 8px 20px rgba(22, 160, 133, 0.15)'; this.style.borderColor='#16A085';"
                     onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(44, 62, 80, 0.08)'; this.style.borderColor='transparent';">
                    <div style="font-size: clamp(3rem, 8vw, 4rem); margin-bottom: 18px;">📄</div>
                    <h3 style="color: #2C3E50; margin: 0 0 10px; font-size: clamp(1.15rem, 2.5vw, 1.35rem); font-weight: 600;">Create Bill</h3>
                    <p style="color: #7F8C8D; margin: 0; font-size: 0.95rem; line-height: 1.5;">Generate blockchain-secured medical bill</p>
                </div>
            </a>

            <!-- View Patients -->
            <a href="/Hospital/ViewPatients" style="text-decoration: none;">
                <div style="background: #FFFFFF; padding: 40px 30px; border-radius: 10px; box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08); text-align: center; transition: all 0.3s ease; border: 2px solid transparent; min-height: 220px; display: flex; flex-direction: column; justify-content: center;"
                     onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 8px 20px rgba(0, 120, 215, 0.15)'; this.style.borderColor='#0078D7';"
                     onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(44, 62, 80, 0.08)'; this.style.borderColor='transparent';">
                    <div style="font-size: clamp(3rem, 8vw, 4rem); margin-bottom: 18px;">👥</div>
                    <h3 style="color: #2C3E50; margin: 0 0 10px; font-size: clamp(1.15rem, 2.5vw, 1.35rem); font-weight: 600;">View All Patients</h3>
                    <p style="color: #7F8C8D; margin: 0; font-size: 0.95rem; line-height: 1.5;">Browse patient records and history</p>
                </div>
            </a>

            <!-- Verify Blockchain -->
            <a href="/Patient/VerifyBlockchain" style="text-decoration: none;">
                <div style="background: #FFFFFF; padding: 40px 30px; border-radius: 10px; box-shadow: 0 2px 8px rgba(44, 62, 80, 0.08); text-align: center; transition: all 0.3s ease; border: 2px solid transparent; min-height: 220px; display: flex; flex-direction: column; justify-content: center;"
                     onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 8px 20px rgba(142, 68, 173, 0.15)'; this.style.borderColor='#8E44AD';"
                     onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(44, 62, 80, 0.08)'; this.style.borderColor='transparent';">
                    <div style="font-size: clamp(3rem, 8vw, 4rem); margin-bottom: 18px;">🔗</div>
                    <h3 style="color: #2C3E50; margin: 0 0 10px; font-size: clamp(1.15rem, 2.5vw, 1.35rem); font-weight: 600;">Verify Blockchain</h3>
                    <p style="color: #7F8C8D; margin: 0; font-size: 0.95rem; line-height: 1.5;">Test blockchain integrity & tampering detection</p>
                </div>
            </a>
        </div>

        <!-- All Patients Table -->
        @if (ViewBag.RecentPatients != null && ViewBag.RecentPatients.Count > 0)
        {
            <div style="background: #FFFFFF; border-radius: 12px; box-shadow: 0 2px 12px rgba(44, 62, 80, 0.08); overflow: hidden; margin-bottom: 30px;">
                <div style="background: linear-gradient(135deg, #0078D7 0%, #005A9E 100%); color: white; padding: 22px 28px;">
                    <h4 style="margin: 0; font-weight: 600; font-size: clamp(1.1rem, 2vw, 1.25rem);">📋 All Registered Patients (@ViewBag.TotalPatients)</h4>
                </div>
                <div style="padding: 25px; overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: clamp(0.85rem, 1.5vw, 0.95rem);">
                        <thead>
                            <tr style="background-color: #2C3E50; color: white;">
                                <th style="padding: 14px; text-align: left; font-weight: 600;">Patient ID</th>
                                <th style="padding: 14px; text-align: left; font-weight: 600;">Name</th>
                                <th style="padding: 14px; text-align: left; font-weight: 600;">NFT Health ID</th>
                                <th style="padding: 14px; text-align: left; font-weight: 600;">Age</th>
                                <th style="padding: 14px; text-align: left; font-weight: 600;">Gender</th>
                                <th style="padding: 14px; text-align: center; font-weight: 600;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in ViewBag.RecentPatients)
                            {
                                <tr style="transition: background-color 0.2s ease; border-bottom: 1px solid #F0F0F0;"
                                    onmouseover="this.style.backgroundColor='#F5F6FA';"
                                    onmouseout="this.style.backgroundColor='#FFFFFF';">
                                    <td style="padding: 14px; font-weight: 600; color: #0078D7;">@patient.PatientID</td>
                                    <td style="padding: 14px; color: #2C3E50;">@patient.Name</td>
                                    <td style="padding: 14px;">
                                        <code style="background-color: #FFFBEA; padding: 6px 12px; border-radius: 6px; color: #F39C12; font-family: 'Courier New', monospace; border: 1px solid #F1C40F; font-weight: 600; font-size: 0.85rem;">@patient.NFT_ID</code>
                                    </td>
                                    <td style="padding: 14px; color: #2C3E50;">@patient.Age</td>
                                    <td style="padding: 14px; color: #2C3E50;">@patient.Gender</td>
                                    <td style="padding: 14px; text-align: center;">
                                        <a href="/Hospital/PatientDetails/@patient.PatientID" 
                                           style="background-color: #0078D7; color: white; padding: 8px 18px; border-radius: 6px; text-decoration: none; display: inline-block; font-weight: 500; transition: all 0.3s ease; font-size: 0.9rem;"
                                           onmouseover="this.style.backgroundColor='#005A9E'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(0, 120, 215, 0.3)';"
                                           onmouseout="this.style.backgroundColor='#0078D7'; this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
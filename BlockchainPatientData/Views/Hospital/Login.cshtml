@{
    ViewData["Title"] = "Hospital Login";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: #F5F6FA;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .login-container {
            background: #FFFFFF;
            padding: 50px 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(44, 62, 80, 0.1);
            width: 100%;
            max-width: 450px;
        }

        .logo {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo-icon {
            font-size: 3.5rem;
            margin-bottom: 15px;
        }

        h1 {
            color: #2C3E50;
            font-size: 1.75rem;
            font-weight: 600;
            text-align: center;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #7F8C8D;
            font-size: 0.95rem;
            text-align: center;
            margin-bottom: 35px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #2C3E50;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .form-group input {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #E0E0E0;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .form-group input:focus {
            outline: none;
            border-color: #0078D7;
            box-shadow: 0 0 0 3px rgba(0, 120, 215, 0.1);
        }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: #0078D7;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .btn-login:hover {
            background: #005A9E;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 120, 215, 0.3);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .demo-credentials {
            background: #F5F6FA;
            padding: 20px;
            border-radius: 8px;
            margin-top: 30px;
            border-left: 4px solid #0078D7;
        }

        .demo-credentials p {
            margin: 0 0 12px 0;
            color: #2C3E50;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .demo-credentials code {
            background: #FFFFFF;
            padding: 6px 12px;
            border-radius: 6px;
            color: #0078D7;
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
            margin-right: 8px;
        }

        .error-message {
            background: #FEF2F2;
            color: #E74C3C;
            padding: 14px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 4px solid #E74C3C;
            font-size: 0.9rem;
        }

        .back-link {
            text-align: center;
            margin-top: 25px;
        }

        .back-link a {
            color: #0078D7;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .back-link a:hover {
            color: #005A9E;
            text-decoration: underline;
        }

        @@media (max-width: 768px) {
            .login-container {
                padding: 40px 30px;
            }

            h1 {
                font-size: 1.5rem;
            }

            .logo-icon {
                font-size: 3rem;
            }
        }

        @@media (max-width: 480px) {
            body {
                padding: 15px;
            }

            .login-container {
                padding: 30px 20px;
            }

            h1 {
                font-size: 1.35rem;
            }

            .demo-credentials code {
                font-size: 0.85rem;
                padding: 5px 10px;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo">
            <div class="logo-icon">🏥</div>
            <h1>Hospital Portal</h1>
            <p class="subtitle">Sign in to manage patient records</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                ❌ @ViewBag.Error
            </div>
        }

        <form method="post" asp-action="Login" asp-controller="Hospital">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" placeholder="Enter your username" required autofocus />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password" required />
            </div>

            <button type="submit" class="btn-login">
                Sign In
            </button>
        </form>

        <div class="demo-credentials">
            <p>📋 Demo Credentials:</p>
            <div>
                <code>hospital</code>
                <code>admin123</code>
            </div>
        </div>

        <div class="back-link">
            <a href="/">← Back to Home</a>
        </div>
    </div>
</body>
</html>

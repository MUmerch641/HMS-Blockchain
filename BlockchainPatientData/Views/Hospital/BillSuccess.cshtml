@{
    ViewData["Title"] = "Bill Created Successfully";
}

<div style="max-width: 1100px; margin: 60px auto; padding: 0 20px;">
    <div style="background: white; border-radius: 15px; box-shadow: 0 15px 50px rgba(0,0,0,0.2); overflow: hidden; border: 3px solid #198754;">
        <div style="background: linear-gradient(135deg, #198754 0%, #146c43 100%); color: white; padding: 30px; text-align: center;">
            <h2 style="margin: 0; font-size: 2.2rem; font-weight: 700;">✅ Bill Created Successfully!</h2>
        </div>
        <div style="padding: 40px;">
            <div style="text-align: center; margin-bottom: 30px;">
                <div style="font-size: 7rem; margin-bottom: 15px; animation: scaleIn 0.5s ease;">✓</div>
                <p style="font-size: 1.3rem; color: #6c757d; margin: 0;">Your bill has been added to the blockchain ledger</p>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
                <div style="padding: 20px; border: 2px solid #e2e8f0; border-radius: 10px; background: linear-gradient(145deg, #f8f9fa 0%, #e9ecef 100%); transition: all 0.3s ease;"
                     onmouseover="this.style.backgroundColor='#e8f4f8'; this.style.transform='translateY(-5px)';"
                     onmouseout="this.style.backgroundColor=''; this.style.transform='translateY(0)';">
                    <strong style="display: block; color: #6c757d; margin-bottom: 10px;">Bill ID:</strong>
                    <h4 style="color: #0d6efd; margin: 0; font-size: 1.8rem; font-weight: 700;">#@ViewBag.BillID</h4>
                </div>

                <div style="padding: 20px; border: 2px solid #e2e8f0; border-radius: 10px; background: linear-gradient(145deg, #f8f9fa 0%, #e9ecef 100%); transition: all 0.3s ease;"
                     onmouseover="this.style.backgroundColor='#e8f4f8'; this.style.transform='translateY(-5px)';"
                     onmouseout="this.style.backgroundColor=''; this.style.transform='translateY(0)';">
                    <strong style="display: block; color: #6c757d; margin-bottom: 10px;">Amount:</strong>
                    <h4 style="color: #198754; margin: 0; font-size: 1.8rem; font-weight: 700;">$@ViewBag.Amount</h4>
                </div>
            </div>

            <div style="margin-bottom: 25px;">
                <div style="background: linear-gradient(135deg, #343a40 0%, #212529 100%); color: white; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 20px rgba(0,0,0,0.3);">
                    <div style="background: rgba(255,255,255,0.1); padding: 15px;">
                        <h5 style="margin: 0; font-weight: 600;">🔗 Blockchain Information</h5>
                    </div>
                    <div style="padding: 25px;">
                        <p style="margin: 0 0 10px 0; font-weight: 600;">SHA256 Hash:</p>
                        <code style="display: block; padding: 15px; background-color: rgba(255,255,255,0.1); border-radius: 8px; color: #68d391; font-family: 'Courier New', monospace; word-break: break-all; font-size: 0.95rem;">@ViewBag.BlockchainHash</code>
                        <p style="margin: 15px 0 0 0; color: rgba(255,255,255,0.8); font-size: 0.9rem;">
                            This hash serves as immutable proof that the bill data is stored on the blockchain.
                        </p>
                    </div>
                </div>
            </div>

            <div style="margin-bottom: 25px;">
                <div style="border: 2px solid #0dcaf0; border-radius: 12px; overflow: hidden;">
                    <div style="background-color: #0dcaf0; color: white; padding: 15px;">
                        <h5 style="margin: 0; font-weight: 600;">📜 Smart Contract Status</h5>
                    </div>
                    <div style="padding: 20px; background-color: #f8f9fa;">
                        <p style="margin: 0; font-size: 1.1rem; font-weight: 600; color: #2d3748;">
                            @ViewBag.InsuranceStatus
                        </p>
                    </div>
                </div>
            </div>

            @if (ViewBag.FraudAlert != null && ViewBag.FraudAlert)
            {
                <div style="margin-bottom: 25px;">
                    <div style="background-color: #fff3cd; border: 2px solid #ffc107; border-radius: 10px; padding: 20px; border-left: 6px solid #ffc107;">
                        <h5 style="color: #856404; margin: 0 0 10px 0; font-weight: 600;">⚠️ AI Fraud Detection Alert</h5>
                        <p style="margin: 0 0 10px 0; color: #856404; font-weight: 600;">@ViewBag.FraudMessage</p>
                        <p style="margin: 0 0 15px 0; color: #856404;">Risk Score: <strong>@ViewBag.RiskScore/100</strong></p>
                        <hr style="border: none; border-top: 1px solid #ffc107; margin: 15px 0;" />
                        <small style="color: #856404;">This transaction has been flagged for manual review by insurance team.</small>
                    </div>
                </div>
            }
            else
            {
                <div style="margin-bottom: 25px;">
                    <div style="background-color: #d1e7dd; border: 2px solid #198754; border-radius: 10px; padding: 15px; border-left: 6px solid #198754;">
                        <strong style="color: #0a3622;">✅ Fraud Detection: Transaction appears normal</strong>
                    </div>
                </div>
            }

            <div style="display: grid; gap: 15px; margin-top: 30px;">
                <a href="/Hospital/AddBill" 
                   style="width: 100%; padding: 14px; background: linear-gradient(135deg, #198754 0%, #146c43 100%); color: white; text-align: center; border-radius: 8px; text-decoration: none; font-size: 1.1rem; font-weight: 600; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(25, 135, 84, 0.4)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                    Create Another Bill
                </a>
                <a href="/Hospital/ViewBills" 
                   style="width: 100%; padding: 12px; background-color: #0dcaf0; color: white; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 500; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.backgroundColor='#0aa2c0';"
                   onmouseout="this.style.backgroundColor='#0dcaf0';">
                    View All Bills
                </a>
                <a href="/Hospital/Dashboard" 
                   style="width: 100%; padding: 12px; background-color: #6c757d; color: white; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 500; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.backgroundColor='#5a6268';"
                   onmouseout="this.style.backgroundColor='#6c757d';">
                    Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes scaleIn {
        from { transform: scale(0); }
        to { transform: scale(1); }
    }
</style>

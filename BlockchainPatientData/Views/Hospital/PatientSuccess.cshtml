@model BlockchainPatientData.Models.Patient

@{
    ViewData["Title"] = "Patient Registered";
}

<div style="max-width: 900px; margin: 60px auto; padding: 0 20px;">
    <div style="background: white; border-radius: 15px; box-shadow: 0 15px 50px rgba(0,0,0,0.2); overflow: hidden; border: 3px solid #198754;">
        <div style="background: linear-gradient(135deg, #198754 0%, #146c43 100%); color: white; padding: 30px; text-align: center;">
            <h2 style="margin: 0; font-size: 2.2rem; font-weight: 700;">✅ Patient Registered Successfully!</h2>
        </div>
        <div style="padding: 40px; text-align: center;">
            <div style="font-size: 7rem; margin-bottom: 20px; animation: scaleIn 0.5s ease;">✓</div>
            <h3 style="margin-bottom: 30px; font-size: 2rem; color: #2d3748;">@Model.Name</h3>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
                <div style="border: 2px solid #e2e8f0; border-radius: 10px; padding: 20px; background: linear-gradient(145deg, #f8f9fa 0%, #e9ecef 100%);">
                    <strong style="display: block; color: #6c757d; margin-bottom: 10px; font-size: 1rem;">Patient ID:</strong>
                    <h4 style="color: #0d6efd; margin: 0; font-size: 1.8rem; font-weight: 700;">#@Model.PatientID</h4>
                </div>
                <div style="border: 2px solid #e2e8f0; border-radius: 10px; padding: 20px; background: linear-gradient(145deg, #f8f9fa 0%, #e9ecef 100%);">
                    <strong style="display: block; color: #6c757d; margin-bottom: 10px; font-size: 1rem;">Age / Gender:</strong>
                    <h4 style="margin: 0; font-size: 1.8rem; font-weight: 700; color: #2d3748;">@Model.Age years / @Model.Gender</h4>
                </div>
            </div>

            <div style="background: linear-gradient(135deg, #343a40 0%, #212529 100%); color: white; border-radius: 12px; overflow: hidden; margin-bottom: 30px; box-shadow: 0 8px 20px rgba(0,0,0,0.3);">
                <div style="background: rgba(255,255,255,0.1); padding: 15px;">
                    <h5 style="margin: 0; font-weight: 600;">🎫 NFT Health ID (Blockchain Identity)</h5>
                </div>
                <div style="padding: 25px;">
                    <code style="font-size: 1.5rem; background-color: rgba(255,255,255,0.1); padding: 15px 20px; border-radius: 8px; display: inline-block; color: #68d391; font-family: 'Courier New', monospace; font-weight: 600; letter-spacing: 1px;">@Model.NFT_ID</code>
                    <p style="margin: 20px 0 0 0; color: rgba(255,255,255,0.8); font-size: 0.95rem;">
                        This unique NFT token represents the patient's blockchain identity
                    </p>
                </div>
            </div>

            <div style="display: grid; gap: 15px;">
                <a href="/Hospital/AddPatient" 
                   style="width: 100%; padding: 14px; background: linear-gradient(135deg, #198754 0%, #146c43 100%); color: white; text-align: center; border-radius: 8px; text-decoration: none; font-size: 1.1rem; font-weight: 600; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(25, 135, 84, 0.4)';"
                   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                    Register Another Patient
                </a>
                <a href="/Hospital/AddBill" 
                   style="width: 100%; padding: 12px; background-color: #0d6efd; color: white; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 500; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.backgroundColor='#0a58ca';"
                   onmouseout="this.style.backgroundColor='#0d6efd';">
                    Create Bill for this Patient
                </a>
                <a href="/Hospital/Dashboard" 
                   style="width: 100%; padding: 12px; background-color: #6c757d; color: white; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 500; display: block; transition: all 0.3s ease;"
                   onmouseover="this.style.backgroundColor='#5a6268';"
                   onmouseout="this.style.backgroundColor='#6c757d';">
                    Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes scaleIn {
        from { transform: scale(0); }
        to { transform: scale(1); }
    }
</style>

@model BlockchainPatientData.Models.Patient
@{
    ViewData["Title"] = "View Records";
}

<div style="min-height: 100vh; background: #F5F6FA; padding: 40px 20px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <div style="max-width: 900px; margin: 0 auto;">
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(44,62,80,0.08); overflow: hidden;">
            
            <div style="background: linear-gradient(135deg, #0078D7 0%, #005A9E 100%); padding: 30px; color: white;">
                <h2 style="margin: 0; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600;">📄 Medical Records</h2>
            </div>

            <div style="padding: 40px;">
                <div style="text-align: center; margin-bottom: 30px;">
                    <div style="background: linear-gradient(135deg, #0078D7 0%, #005A9E 100%); display: inline-block; padding: 20px 40px; border-radius: 15px; color: white;">
                        <div style="opacity: 0.9; margin-bottom: 5px;">NFT Health ID</div>
                        <div style="font-size: clamp(1.5rem, 4vw, 1.8rem); font-weight: 700; font-family: 'Courier New', monospace;">@Model.NFT_ID</div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                    <div style="background: #F7FAFC; padding: 20px; border-radius: 12px; border-left: 4px solid #0078D7;">
                        <div style="color: #7F8C8D; margin-bottom: 5px;">Full Name</div>
                        <div style="color: #2C3E50; font-weight: 600; font-size: 1.2rem;">@Model.Name</div>
                    </div>
                    <div style="background: #F7FAFC; padding: 20px; border-radius: 12px; border-left: 4px solid #16A085;">
                        <div style="color: #7F8C8D; margin-bottom: 5px;">Age</div>
                        <div style="color: #2C3E50; font-weight: 600; font-size: 1.2rem;">@Model.Age years</div>
                    </div>
                    <div style="background: #F7FAFC; padding: 20px; border-radius: 12px; border-left: 4px solid #9B59B6;">
                        <div style="color: #7F8C8D; margin-bottom: 5px;">Gender</div>
                        <div style="color: #2C3E50; font-weight: 600; font-size: 1.2rem;">@Model.Gender</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.BloodGroup))
                    {
                        <div style="background: #FEE2E2; padding: 20px; border-radius: 12px; border-left: 4px solid #E74C3C;">
                            <div style="color: #7F8C8D; margin-bottom: 5px;">Blood Group</div>
                            <div style="color: #C0392B; font-weight: 700; font-size: 1.2rem;">🩸 @Model.BloodGroup</div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.PhoneNumber) || !string.IsNullOrEmpty(Model.Email))
                {
                    <div style="background: #F7FAFC; padding: 25px; border-radius: 12px; margin-top: 20px;">
                        <h3 style="margin: 0 0 15px 0; color: #2C3E50;">Contact Information</h3>
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <div style="margin-bottom: 10px;">
                                <span style="color: #7F8C8D;">Phone:</span>
                                <strong style="color: #2d3748; margin-left: 10px;">@Model.PhoneNumber</strong>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <div>
                                <span style="color: #718096;">Email:</span>
                                <strong style="color: #2d3748; margin-left: 10px;">@Model.Email</strong>
                            </div>
                        }
                    </div>
                }

                <div style="margin-top: 30px; text-align: center;">
                    <a href="/Patient/Dashboard/@Model.PatientID" style="display: inline-block; background: #667eea; color: white; padding: 12px 30px; border-radius: 10px; text-decoration: none; font-weight: 500;">
                        ← Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

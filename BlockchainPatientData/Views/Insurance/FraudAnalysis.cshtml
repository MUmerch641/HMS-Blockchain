@model List<BlockchainPatientData.Models.InsuranceClaim>
@{
    ViewData["Title"] = "Fraud Analysis";
}

<div style="min-height: 100vh; background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); padding: 40px 20px;">
    <div style="max-width: 1400px; margin: 0 auto;">
        <div style="background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); overflow: hidden;">
            
            <div style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); padding: 30px; color: white;">
                <h2 style="margin: 0 0 10px 0; font-size: 2rem; font-weight: 600;">🚨 Fraud Detection Analysis</h2>
                <p style="margin: 0; opacity: 0.9;">AI-powered suspicious claim detection</p>
            </div>

            <div style="padding: 30px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 30px;">
                    <div style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); padding: 20px; border-radius: 15px; color: white;">
                        <div style="opacity: 0.9; margin-bottom: 5px;">Fraud Cases</div>
                        <div style="font-size: 2.5rem; font-weight: 700;">@ViewBag.TotalFraudCases</div>
                    </div>
                    <div style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); padding: 20px; border-radius: 15px; color: white;">
                        <div style="opacity: 0.9; margin-bottom: 5px;">Total Fraud Amount</div>
                        <div style="font-size: 2.5rem; font-weight: 700;">$@ViewBag.TotalFraudAmount.ToString("N0")</div>
                    </div>
                </div>

                @if (Model == null || !Model.Any())
                {
                    <div style="text-align: center; padding: 60px 20px;">
                        <div style="font-size: 4rem; margin-bottom: 20px;">✅</div>
                        <h3 style="color: #10b981; margin-bottom: 10px;">No Fraudulent Claims Detected</h3>
                        <p style="color: #718096;">All claims appear legitimate based on AI analysis.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white;">
                                    <th style="padding: 15px; text-align: left;">Claim ID</th>
                                    <th style="padding: 15px; text-align: left;">Patient ID</th>
                                    <th style="padding: 15px; text-align: right;">Amount</th>
                                    <th style="padding: 15px; text-align: center;">Status</th>
                                    <th style="padding: 15px; text-align: left;">Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model)
                                {
                                    <tr style="border-bottom: 1px solid #e2e8f0;"
                                        onmouseover="this.style.backgroundColor='#fef2f2'"
                                        onmouseout="this.style.backgroundColor='white'">
                                        <td style="padding: 15px; font-weight: 500; color: #ef4444;">#@claim.ClaimID</td>
                                        <td style="padding: 15px;">Patient #@claim.PatientID</td>
                                        <td style="padding: 15px; text-align: right; font-weight: 600;">$@claim.Amount.ToString("N2")</td>
                                        <td style="padding: 15px; text-align: center;">
                                            <span style="background: #fee2e2; color: #991b1b; padding: 6px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;">@claim.Status</span>
                                        </td>
                                        <td style="padding: 15px;">@claim.ClaimDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div style="margin-top: 30px; text-align: center;">
                    <a href="/Insurance/Dashboard" style="display: inline-block; background: #e2e8f0; color: #4a5568; padding: 12px 30px; border-radius: 10px; text-decoration: none; font-weight: 500;">
                        ← Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
